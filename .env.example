# Site URL (used for canonical URLs and Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://marprojector.ammararief.my.id

# Contact Form Email (Resend HTTP API)
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Cloudflare Web Analytics (optional)
# Get the token from Cloudflare Dashboard > Analytics & Logs > Web Analytics
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Google Analytics Configuration (optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id
